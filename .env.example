# Copy to .env and fill in what you use. With nothing set, the offline "mock" provider is used.
DEFAULT_PROVIDER=mock
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=   # any OpenAI-compatible server (vLLM, Groq, ...)
# OLLAMA_MODEL=llama3.1   # local model via Ollama
CHAT_DB_PATH=chat.db
MAX_CONTEXT_TOKENS=6000
MAX_OUTPUT_TOKENS=1024

# RAG (phase 2)
RAG_EMBEDDER=hash   # or openai (needs OPENAI_API_KEY)
RAG_TOP_K=3
RAG_CHUNK_WORDS=120
RAG_OVERLAP_WORDS=20
RAG_MIN_SCORE=0.1
OPENAI_EMBED_MODEL=text-embedding-3-small
RAG_MODE=hybrid   # hybrid, vector or bm25
RAG_MIN_BM25=0.3

# Auth and limits (phase 3)
AUTH_REQUIRED=true   # false = single built-in user, local use only
ALLOW_REGISTRATION=true
SESSION_DAYS=7
RATE_LIMIT_CHAT_PER_MIN=20   # 0 disables
RATE_LIMIT_AUTH_PER_MIN=10

# Phase 4
RAG_RERANK=none   # none, lexical or llm
RAG_CANDIDATES=20
TOOL_MAX_STEPS=4
TOOL_TIMEOUT_SECONDS=5
